APP_VERSION=v3.0.0
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=dog_weight_tracker
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@dog-weight-db:5432/${POSTGRES_DB}

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_DEFAULT_VHOST=/
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_CONNECTION_RETRY_DELAY=2
RABBITMQ_MAX_RETRIES=30
RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS=-rabbit log_levels [{connection,error}]
RABBITMQ_LOGS=/var/log/rabbitmq/rabbit.log

INSTANCE_1_NAME=instance-1
INSTANCE_1_QUEUE=dog_queue_1
INSTANCE_1_PORT=8000

INSTANCE_2_NAME=instance-2
INSTANCE_2_QUEUE=dog_queue_2
INSTANCE_2_PORT=8001